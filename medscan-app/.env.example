# Em web local, use a API local.
EXPO_PUBLIC_API_URL=http://localhost:3000/api

# Em emulador Android, use:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:3000/api

# Em celular fisico, use o IP da sua maquina na rede:
# EXPO_PUBLIC_API_URL=http://SEU_IP:3000/api

# No Environment do Static Site no Render (build de producao):
# EXPO_PUBLIC_API_URL=https://medscan-api-f658.onrender.com/api
# Nunca coloque chaves de IA em variaveis EXPO_PUBLIC_*.
