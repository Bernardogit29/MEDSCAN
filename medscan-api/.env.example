PORT=3000
MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/medscan?retryWrites=true&w=majority
JWT_SECRET=troque_este_segredo
JWT_EXPIRES_IN=7d

# Obrigatoria para analise: sem chave, o endpoint retorna indisponibilidade, sem inventar resultados.
# Gere a chave em https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Usado em falhas HTTP 500/502/503/504 quando nenhuma reserva externa estiver configurada. Vazio reutiliza o modelo principal.
GEMINI_FALLBACK_MODEL=gemini-3.7-flash

# Reserva para relatos de texto. Crie a chave na conta Free em console.groq.com.
# Sem chave não há chamadas à Groq. false desativa a reserva.
GROQ_FALLBACK_ENABLED=true
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Segunda reserva. O modo Free do Mistral Studio oferece API com limites.
# Aceita texto e imagem. Configure a chave apenas no servidor.
MISTRAL_FALLBACK_ENABLED=true
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# Ultima reserva apenas para texto. O modelo openrouter/free usa somente modelos gratuitos,
# mas a escolha do modelo varia e o plano Free limita o numero de requisicoes.
OPENROUTER_FALLBACK_ENABLED=true
OPENROUTER_API_KEY=

# Ultima reserva somente para texto. Chaves de avaliacao/teste da Cohere possuem limites.
COHERE_FALLBACK_ENABLED=true
COHERE_API_KEY=
COHERE_MODEL=command-a-03-2025
